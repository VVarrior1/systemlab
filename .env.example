# Optional. The playground works with browser saves when these are unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Without GEMINI_API_KEY, design-defense submissions fall back to
# self-assessment against the lesson's model answer. Set it to enable
# Gemini-graded defenses. Get a key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Selects the grading model (defaults to gemini-3.8-flash).
GRADER_MODEL=gemini-3.8-flash
