# Optional. The playground works with browser saves when these are unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Without ANTHROPIC_API_KEY, design-defense submissions fall back to
# self-assessment against the lesson's model answer. Set it to enable Claude-graded
# defenses. GRADER_MODEL selects the grading model (defaults to claude-opus-5).
ANTHROPIC_API_KEY=
GRADER_MODEL=
